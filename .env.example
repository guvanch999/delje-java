# DELJE shop configuration.
# The same file is used by the application (systemd EnvironmentFile or the local run)
# and by docker compose (POSTGRES_PASSWORD, POSTGRES_PORT).
# Keep it out of git; on the server: chmod 600.

# HTTP server. On the server the app listens on localhost only, nginx is in front.
PORT=3000
SERVER_ADDRESS=127.0.0.1
LOG_LEVEL=info

# Public address of the site, used for canonical links, hreflang and sitemap.xml.
# Production: https://shop.guvanch.site
SITE_URL=http://localhost:3000

# Database. Use a password without '$' characters, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://shop:change-me@127.0.0.1:5432/shop

# true behind HTTPS (production), false for plain http://localhost
COOKIE_SECURE=false

# Admin panel account. Hash: java -jar delje.jar hash-password <password>
# Keep the hash in single quotes (it contains '$').
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=''

# Contact form e-mails through Resend (https://resend.com).
# MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
ADMIN_EMAIL=
MAIL_FROM=DELJE <noreply@shop.guvanch.site>

# Storage for uploaded pictures and database dumps (absolute paths on the server).
UPLOADS_DIR=uploads
BACKUPS_DIR=backups

# Daily pg_dump at 03:00 (server time), dumps older than 14 days are removed.
BACKUP_ENABLED=false
PG_DUMP_PATH=pg_dump
